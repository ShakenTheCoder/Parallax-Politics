# --- Core ---
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_USER=parallax
POSTGRES_PASSWORD=parallax
POSTGRES_DB=parallax
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://parallax:parallax@localhost:5433/parallax

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# --- Scheduled briefs ---
DAILY_BRIEF_HOUR_UTC=6
JWT_PRIVILEGED_EXPIRES_MINUTES=15
JWT_ISSUER=parallax-politics
JWT_AUDIENCE=parallax-web
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900

# --- LLM ---
# Use local Ollama for development; set LLM_PROVIDER=nvidia for hosted NIM.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_CHEAP_MODEL=gpt-oss:20b
OLLAMA_ACTIVITY_MODEL=llama3:latest
OLLAMA_DEFAULT_MODEL=gpt-oss:20b
OLLAMA_ESCALATE_MODEL=gpt-oss:20b
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DAILY_BUDGET_USD=25.00
PER_RUN_BUDGET_USD=0.50
DAILY_OPUS_BUDGET_USD=5.00
LLM_REQUEST_TIMEOUT_SECONDS=35
BRIEF_RUN_TIMEOUT_SECONDS=120

# --- EXA ---
EXA_API_KEY=exa-xxx
EXA_DAILY_CALL_CAP=500
EXA_REQUEST_TIMEOUT_SECONDS=20

# --- Free publisher RSS intelligence ---
FREE_RSS_ENABLED=true
FREE_RSS_MAX_ITEMS_PER_FEED=100
FREE_RSS_REQUEST_TIMEOUT_SECONDS=15
FREE_YOUTUBE_FEEDS_ENABLED=true
FREE_YOUTUBE_MAX_ITEMS_PER_FEED=15
POLITICAL_ACTIVITY_MAX_LLM_ITEMS_PER_RUN=12

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
