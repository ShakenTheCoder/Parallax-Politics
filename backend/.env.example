# --- Core ---
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_USER=parallax
POSTGRES_PASSWORD=parallax
POSTGRES_DB=parallax
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://parallax:parallax@localhost:5433/parallax

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_PRIVILEGED_EXPIRES_MINUTES=15
JWT_ISSUER=parallax-politics
JWT_AUDIENCE=parallax-web
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900

# --- LLM ---
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_DISABLED=false
DAILY_BUDGET_USD=25.00
PER_RUN_BUDGET_USD=0.50
DAILY_OPUS_BUDGET_USD=5.00

# --- EXA ---
EXA_API_KEY=exa-xxx
EXA_DAILY_CALL_CAP=500

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
